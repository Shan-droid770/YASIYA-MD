# ===== SAHAN-MD PRO configuration =====
# Copy this file to .env and fill in your values.

# Bot branding
BOT_NAME=SAHAN-MD PRO
OWNER_NAME=Sahan

# Your WhatsApp number(s), international format, digits only, comma-separated.
# Example (Sri Lanka): 9471XXXXXXX
OWNER_NUMBER=

# Command prefix
PREFIX=.

# 'public' = anyone can use commands, 'private' = only owner
MODE=public

# Behaviour
AUTO_READ=false
ALWAYS_ONLINE=true

# Web dashboard port
PORT=8000
